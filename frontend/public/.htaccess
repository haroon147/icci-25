<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files and directories normally (assets, PDFs, images, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send React Router URLs to the single-page application entry point.
  RewriteRule ^ index.html [L]
</IfModule>
